import matplotlib.pyplot as plt
import numpy as np
from sklearn.linear_model import LinearRegression

# Sample dataset: [Square Footage, Number of Bedrooms] vs Price ($k)
X = np.array([
    [1400, 3],
    [1600, 3],
    [1700, 4],
    [1875, 4],
    [1100, 2],
    [1550, 3],
    [2350, 4],
    [2450, 5],
    [1425, 3],
    [1700, 3],
])
y = np.array([245, 315, 305, 340, 190, 290, 410, 450, 250, 300])

# Train the multivariate linear regression model
model = LinearRegression()
model.fit(X, y)

# Create a mesh grid for plotting the regression plane
x1_range = np.linspace(X[:, 0].min(), X[:, 0].max(), 20)
x2_range = np.linspace(X[:, 1].min(), X[:, 1].max(), 20)
x1_surf, x2_surf = np.meshgrid(x1_range, x2_range)
y_surf = (
    model.intercept_ + model.coef_[0] * x1_surf + model.coef_[1] * x2_surf
)

# Initialize 3D plot
fig = plt.figure(figsize=(10, 7))
ax = fig.add_subplot(projection="3d")

# Plot actual data points as a scatter plot
ax.scatter(
    X[:, 0],
    X[:, 1],
    y,
    color="red",
    s=60,
    label="Actual Prices",
    depthshade=True,
)

# Plot the regression model plane
ax.plot_surface(
    x1_surf,
    x2_surf,
    y_surf,
    color="skyblue",
    alpha=0.6,
    edgecolor="lightgray",
)

# Set labels and title
ax.set_xlabel("Square Footage")
ax.set_ylabel("Bedrooms")
ax.set_zlabel("Price ($k)")
ax.set_title("3D House Price Prediction Model & Regression Plane")

plt.legend()
plt.show()